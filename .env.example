# ==================== Turso ====================
# احصل عليهما من: https://turso.tech → قاعدة بياناتك → Settings

TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ==================== للتشغيل المحلي ====================
# يمكنك استخدام ملف SQLite محلي بدل Turso للتطوير:
# TURSO_DATABASE_URL=file:./malines.db
# TURSO_AUTH_TOKEN=   (اتركه فارغاً)
